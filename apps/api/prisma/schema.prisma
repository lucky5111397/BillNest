datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Minimal foundational health model to verify Prisma client generation, migrations,
/// and database connectivity in Phase 0 without premature business schema definitions.
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

